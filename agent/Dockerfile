# Generated from the AgentSpec `agent` – do not edit by hand (ADR-0096).
#
# The builder image has all dependencies vendored and compiled, so this build needs no
# network (`docker build --network none .`) and compiles only the agent crate.
FROM registry.agentswork.de/grauwolf-builder:0.1.1 AS build
# The builder must be the version of the grauwolf that generated this crate.
RUN test "$GRAUWOLF_VERSION" = "0.1.1" || { \
    echo "crate generated by grauwolf 0.1.1, builder is $GRAUWOLF_VERSION - regenerate with grauwolf $GRAUWOLF_VERSION or pass --builder-image with --allow-builder-mismatch" >&2; exit 1; }
WORKDIR /src
COPY . .
# The lock file of the builder: the versions of the pre-built dependencies.
RUN cp /opt/grauwolf/Cargo.lock Cargo.lock \
    && CARGO_TARGET_DIR=/opt/grauwolf/target cargo build --release --offline --features service \
    && cp /opt/grauwolf/target/release/agent /usr/local/bin/agent

FROM gcr.io/distroless/cc-debian12:nonroot
COPY --from=build /usr/local/bin/agent /usr/local/bin/agent
COPY --chown=65532:65532 app/ /app/
WORKDIR /app
ENV GRAUWOLF_DATA_DIR=/app SERVER_PORT=8080
EXPOSE 8080
ENTRYPOINT ["/usr/local/bin/agent"]
